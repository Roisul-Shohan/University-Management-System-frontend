# Frontend Environment Variables
# Copy this file to .env.local for local development
# For production, set these in your deployment platform (Vercel, Netlify, etc.)

# Backend API URL - REQUIRED
# Local development: http://localhost:5000
# Production: https://your-backend-domain.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Demo account credentials (optional - for demo login buttons)
# Set these in production to enable demo logins
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_TEACHER_EMAIL=
NEXT_PUBLIC_DEMO_TEACHER_PASSWORD=
NEXT_PUBLIC_DEMO_STUDENT_EMAIL=
NEXT_PUBLIC_DEMO_STUDENT_PASSWORD=